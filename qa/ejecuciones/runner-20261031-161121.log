            {
                "severidad": severidad,
                "tipo": tipo,
                "linea": linea,
                "id": id_,
                "mensaje": mensaje,
                "cita": cita,
            }
        )

    # 1. AC con formato Dado/Cuando/Entonces
    for ac in por_tipo.get("AC", []):
        if not AC_GWT.search(ac["texto"]):
            add(
                "bloqueante",
                "formato-AC",
                ac["linea"],
