#!/usr/bin/env python3
"""Runner secuencial del pipeline de Pharma Express.

Ejecuta el siguiente paso que indique orquestador.py, o recorre la secuencia
hasta la próxima puerta humana. No aprueba nada por su cuenta: las puertas de
MVP, oráculos, SPEC y entrega siempre se detienen.

Backends:
  - claude    : usa `claude -p` y los subagentes de .claude/agents/.
  - opencode  : usa `opencode run --agent general` y le pasa el archivo del
                subagente como instrucción (respaldo cuando no hay Claude Code).
  - python    : usa agentes-ia/agente.py para Especificaciones y Arquitectura.

Uso:
    python3 qa/scripts/runner.py --estado
    python3 qa/scripts/runner.py --dry-run
    python3 qa/scripts/runner.py --todo
    python3 qa/scripts/runner.py --paso S1 --modulo identidad
    python3 qa/scripts/runner.py --todo --backend opencode

Código de salida: 0 si terminó o se detuvo en una puerta humana; 1 si falló.
"""

from __future__ import annotations

import argparse
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

RAIZ = Path(__file__).resolve().parents[2]
ORQUESTADOR = RAIZ / "orquestador.py"
PIPELINE = RAIZ / "pipeline.json"
MARCAR = RAIZ / "qa" / "scripts" / "marcar.py"
LOG_DIR = RAIZ / "qa" / "ejecuciones"
AGENTES_DIR = RAIZ / ".claude" / "agents"

# paso del orquestador -> (agente de Claude/OpenCode, archivo, tipo)
AGENTES = {
    "S1": ("qa-s1-revisor-spec", "qa-s1-revisor-spec.md", "subagente"),
    "S2": ("qa-s2-disenador-casos", "qa-s2-disenador-casos.md", "subagente"),
    "S3": ("qa-s3-generador-pruebas", "qa-s3-generador-pruebas.md", "subagente"),
    "B1/B4": ("backend-servicios-api", "backend-servicios-api.md", "subagente"),
    "R1": ("qa-r1-humo", "qa-r1-humo.md", "subagente"),
}

PUERTAS = {"mvp", "registrar-modulos", "spec", "escalado", "escalar", "entrega"}


def cargar_orquestador():
    spec = importlib.util.spec_from_file_location("orquestador", ORQUESTADOR)
    if spec is None or spec.loader is None:
        raise RuntimeError("No se pudo cargar orquestador.py")
    modulo = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(modulo)
    return modulo


def leer_pipeline() -> dict:
    try:
        return json.loads(PIPELINE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        sys.exit(f"No se pudo leer pipeline.json: {exc}")


def siguiente() -> dict:
    return cargar_orquestador().siguiente(leer_pipeline())[0]


def detectar_backend(preferido: str) -> str | None:
    if preferido != "auto":
        return preferido
    if shutil.which("claude"):
        return "claude"
    if shutil.which("opencode"):
        return "opencode"
    return None


def preflight(backend: str | None) -> list[str]:
    problemas = []
    if backend is None:
        problemas.append("No hay `claude` ni `opencode` en el PATH.")
    if backend == "python":
        for modulo in ("openai", "dotenv"):
            if importlib.util.find_spec(modulo) is None:
                problemas.append(f"Falta el paquete Python `{modulo}` (pip install -r agentes-ia/requirements.txt).")
        if not (RAIZ / "agentes-ia" / ".env").is_file() and not os.environ.get("GEMINI_API_KEY"):
            problemas.append("Falta agentes-ia/.env o GEMINI_API_KEY.")
    return problemas


def prompt_para(paso: str, modulo: str, archivo: str) -> str:
    contexto = (
        f"Trabaja en el repositorio {RAIZ}. Módulo: {modulo}. "
        f"Sigue al pie de la letra el archivo {archivo}. "
        "Lee primero docs/mvp.md y tu archivo de agente. "
        "No pidas confirmación interactiva: ejecuta hasta terminar o hasta una puerta humana. "
        "No inventes datos de salud: usa solo datos sintéticos. "
        "Cuando termines, escribe tus salidas en las rutas que indica el agente."
    )
    tareas = {
        "S1": "Revisa la SPEC del módulo y deja el informe en qa/revision/ con veredicto APTA, APTA_CON_RESERVAS o NO_APTA.",
        "S2": "Diseña los casos TC-* y actualiza qa/trazabilidad.md y qa/oraculos-pendientes.md.",
        "S3": "Genera las pruebas ejecutables de los TC aprobados y déjalas rojas por 'no implementado'.",
        "B1/B4": "Implementa el módulo y ejecuta la suite hasta dejarla verde, sin tocar pruebas.",
        "R1": "Ejecuta el humo del módulo contra el entorno de prueba y deja el informe en qa/humo/.",
    }
    return f"{contexto}\n\nTAREA: {tareas.get(paso, 'Ejecuta tu tarea.')}"


def comando(backend: str, paso: str, modulo: str) -> list[str]:
    especiales = {
        "B1": ("backend-servicios-api", "backend-servicios-api.md"),
        "B2": ("backend-bot-telegram", "backend-bot-telegram.md"),
        "B3": ("frontend-interfaz-web", "frontend-interfaz-web.md"),
        "B4": ("ejecutor-corrector", "ejecutor-corrector.md"),
    }
    if paso in especiales:
        agente, archivo = especiales[paso]
    else:
        agente, archivo = AGENTES[paso][0], AGENTES[paso][1]

    prompt = prompt_para(paso, modulo, f".claude/agents/{archivo}")
    if backend == "claude":
        return ["claude", "-p", f"Usa el subagente {agente}. {prompt}"]
    if backend == "opencode":
        return ["opencode", "run", "--agent", "general", "--auto", "--format", "default", prompt]
    raise ValueError(f"Backend no soportado para ejecutar: {backend}")


def ejecutar_backend(backend: str, paso: str, modulo: str, timeout: int, log) -> int:
    cmd = comando(backend, paso, modulo)
    print(f"\n$ {' '.join(cmd[:5])} ...\n")
    try:
        proc = subprocess.Popen(
            cmd,
            cwd=RAIZ,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )
    except FileNotFoundError:
        print(f"No se encontró el ejecutable para el backend {backend}.", file=sys.stderr)
        return 127

    inicio = time.time()
    try:
        assert proc.stdout is not None
        for linea in proc.stdout:
            print(linea, end="")
            log.write(linea)
        proc.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        print(f"\nTiempo agotado tras {timeout}s.", file=sys.stderr)
        return 124
    finally:
        print(f"\n[runner] {paso} terminó en {time.time() - inicio:.1f}s con código {proc.returncode}.")
    return proc.returncode


def marcar(*args: str) -> int:
    cmd = [sys.executable, str(MARCAR), *args]
    return subprocess.run(cmd, cwd=RAIZ).returncode


def informe_mas_reciente(carpeta: Path, patron: str = "*.md") -> Path | None:
    if not carpeta.is_dir():
        return None
    archivos = sorted(carpeta.glob(patron), key=lambda p: p.stat().st_mtime, reverse=True)
    return archivos[0] if archivos else None


def veredicto_s1() -> str | None:
    informe = informe_mas_reciente(RAIZ / "qa" / "revision")
    if not informe:
        return None
    texto = informe.read_text(encoding="utf-8", errors="replace").upper()
    if "NO_APTA" in texto:
        return "NO_APTA"
    if "APTA_CON_RESERVAS" in texto:
        return "APTA_CON_RESERVAS"
    if "APTA" in texto:
        return "APTA"
    return None


def resultado_humo() -> str | None:
    informe = informe_mas_reciente(RAIZ / "qa" / "humo", "RUN-humo-*.md")
    if not informe:
        return None
    texto = informe.read_text(encoding="utf-8", errors="replace").lower()
    if "fallido" in texto or "falló" in texto or "fallo" in texto:
        return "fallido"
    if "verde" in texto or "ok" in texto:
        return "verde"
    return None


def describir(accion: dict) -> str:
    return (
        f"[{accion['modulo']}] {accion['paso']} — {accion['responsable']}\n"
        f"  {accion['accion']}\n"
        f"  Bloqueado por: {accion.get('bloqueado_por', '—')}"
    )


def puerta(accion: dict) -> bool:
    return accion["paso"] in PUERTAS


def plan_humano(accion: dict) -> str:
    paso = accion["paso"]
    modulo = accion["modulo"]
    if paso == "mvp":
        return (
            "Puerta humana del MVP. Ejecuta los modos MVP y luego una persona escribe aprobado_por:\n"
            "  python3 agentes-ia/agente.py specification-agent \"priorizar MVP\" --adjuntar ...\n"
            "  python3 agentes-ia/agente.py architecture-agent \"cortar MVP\" --adjuntar ...\n"
            "  python3 qa/scripts/marcar.py mvp --estado aprobado --aprobado-por \"Nombre\""
        )
    if paso == "registrar-modulos":
        return (
            "El MVP ya está aprobado. Registra cada módulo del Corte técnico:\n"
            "  python3 qa/scripts/marcar.py modulo <nombre> --spec pendiente"
        )
    if paso == "spec":
        return (
            f"Aprobación humana de la SPEC del módulo {modulo}. Congélala en "
            f"agentes-ia/salidas/specification-agent/aprobadas/ y marca:\n"
            f"  python3 qa/scripts/marcar.py modulo {modulo} --spec aprobada"
        )
    if paso in ("escalado", "escalar"):
        return "Escalamiento: decide una persona. Revisa el motivo en pipeline.json y resuélvelo con marcar.py."
    if paso == "entrega":
        return "Puerta humana final: revisa la definición de terminado y aprueba la entrega."
    return ""


def main() -> int:
    parser = argparse.ArgumentParser(description="Runner secuencial del pipeline.")
    parser.add_argument("--estado", action="store_true", help="Muestra el siguiente paso y sale.")
    parser.add_argument("--dry-run", action="store_true", help="Muestra la secuencia sin ejecutar agentes.")
    parser.add_argument("--todo", action="store_true", help="Prueba mecánica + preflight + secuencia hasta una puerta.")
    parser.add_argument("--seguir", action="store_true", help="Ejecuta pasos hasta una puerta humana.")
    parser.add_argument("--paso", help="Fuerza un paso: S1, S2, S3, B1/B4, B2, B3, R1.")
    parser.add_argument("--modulo", default=None, help="Módulo sobre el que trabaja el paso forzado.")
    parser.add_argument("--backend", default="auto", choices=["auto", "claude", "opencode", "python"])
    parser.add_argument("--timeout", type=int, default=1200, help="Segundos por agente (por defecto 1200).")
    parser.add_argument("--auto-marcar", action="store_true", help="Marca S1/S3/R1 cuando el resultado es inequívoco.")
    parser.add_argument("--max-pasos", type=int, default=20, help="Tope de pasos en --seguir/--todo.")
    args = parser.parse_args()

    backend = detectar_backend(args.backend)
    accion = siguiente()

    if args.todo:
        print("== 1. Prueba mecánica ==")
        prueba = subprocess.run(
            [sys.executable, str(RAIZ / "qa" / "scripts" / "probar_todo.py")],
            cwd=RAIZ,
        )
        if prueba.returncode != 0:
            print("La prueba mecánica falló; no se ejecutan agentes.", file=sys.stderr)
            return 1

    problemas = preflight(backend)
    if backend == "python":
        problemas += preflight("python")

    print("\n== Runner Pharma Express ==")
    print(f"Backend: {backend or 'ninguno'}")
    if problemas:
        print("Preflight:")
        for problema in problemas:
            print(f"  - {problema}")
    else:
        print("Preflight: OK")
    print(f"\nSiguiente paso:\n{describir(accion)}")

    if args.estado:
        return 0

    if args.dry_run:
        print("\n== Secuencia prevista ==")
        simulado = leer_pipeline()
        orquestador = cargar_orquestador()
        for n in range(args.max_pasos):
            act = orquestador.siguiente(simulado)[0]
            print(f"  {n + 1}. [{act['modulo']}] {act['paso']} — {act['responsable']}")
            if puerta(act):
                print(f"     Se detiene: {plan_humano(act).splitlines()[0]}")
                break
            if act["paso"] == "S1":
                simulado.setdefault("modulos", {}).setdefault(act["modulo"], {})["revision"] = "APTA"
            elif act["paso"] == "S2":
                simulado.setdefault("modulos", {}).setdefault(act["modulo"], {})["oraculos"] = "aprobados"
            elif act["paso"] == "S3":
                simulado.setdefault("modulos", {}).setdefault(act["modulo"], {})["pruebas"] = "rojas"
            elif act["paso"] == "B1/B4":
                simulado.setdefault("modulos", {}).setdefault(act["modulo"], {})["implementacion"] = "verde"
            elif act["paso"] == "R1":
                simulado.setdefault("modulos", {}).setdefault(act["modulo"], {})["humo"] = "verde"
        return 0

    if args.paso:
        if args.paso not in AGENTES and args.paso not in ("B2", "B3"):
            sys.exit(f"Paso no ejecutable: {args.paso}")
        if not args.modulo:
            sys.exit("--paso requiere --modulo.")
        accion = {"paso": args.paso, "modulo": args.modulo, "responsable": "runner"}

    if puerta(accion) and not args.paso:
        print(f"\n{plan_humano(accion)}")
        return 0

    if backend in (None, "python"):
        print(
            "\nNo hay backend de subagentes disponible (claude/opencode). "
            "Instala Claude Code o ejecuta los agentes a mano; ver docs/COMO-PROBAR.md.",
            file=sys.stderr,
        )
        return 1

    LOG_DIR.mkdir(parents=True, exist_ok=True)
    sello = datetime.now().strftime("%Y%m%d-%H%M%S")
    ruta_log = LOG_DIR / f"runner-{sello}.log"
    resumen = {"fecha": sello, "backend": backend, "pasos": []}

    with ruta_log.open("w", encoding="utf-8") as log:
        log.write(f"Runner {sello} | backend={backend}\n")
        pasos = 0
        while pasos < args.max_pasos:
            accion = siguiente()
            print(f"\n== Paso {pasos + 1}: {describir(accion)} ==")
            log.write(f"\n== Paso {pasos + 1}: {describir(accion)} ==\n")

            if puerta(accion):
                print(f"\n{plan_humano(accion)}")
                resumen["detenido_en"] = accion
                break

            paso = accion["paso"]
            modulo = accion["modulo"]
            if paso == "B1/B4":
                for sub in ("B1", "B4"):
                    codigo = ejecutar_backend(backend, sub, modulo, args.timeout, log)
                    if codigo != 0:
                        print(f"{sub} falló con código {codigo}. Se detiene.", file=sys.stderr)
                        resumen["error"] = f"{sub}={codigo}"
                        return 1
            else:
                codigo = ejecutar_backend(backend, paso, modulo, args.timeout, log)
                if codigo != 0:
                    print(f"{paso} falló con código {codigo}. Se detiene.", file=sys.stderr)
                    resumen["error"] = f"{paso}={codigo}"
                    return 1

            resumen["pasos"].append({"paso": paso, "modulo": modulo})
            pasos += 1

            if not args.auto_marcar:
                print(f"\nRevisa la salida y marca el estado con marcar.py. Se detiene para no asumir el resultado.")
                resumen["detenido_en"] = {"motivo": "marcado manual", **accion}
                break

            if paso == "S1":
                veredicto = veredicto_s1()
                if veredicto:
                    marcar("modulo", modulo, "--revision", veredicto)
                    if veredicto == "NO_APTA":
                        print("S1 devolvió NO_APTA: se detiene para volver a Especificaciones.")
                        resumen["detenido_en"] = {"motivo": "NO_APTA", **accion}
                        break
                else:
                    print("S1 no dejó un veredicto legible; se detiene.", file=sys.stderr)
                    resumen["detenido_en"] = {"motivo": "sin veredicto S1", **accion}
                    break
            elif paso == "S3":
                marcar("modulo", modulo, "--pruebas", "rojas")
            elif paso == "R1":
                estado = resultado_humo()
                if estado:
                    marcar("modulo", modulo, "--humo", estado)
                else:
                    print("R1 no dejó un informe legible; se detiene.", file=sys.stderr)
                    resumen["detenido_en"] = {"motivo": "sin informe de humo", **accion}
                    break
            else:
                print(f"{paso} terminó. Revisa y marca el estado; el runner no asume el resultado.")
                resumen["detenido_en"] = {"motivo": "marcado manual", **accion}
                break

        if pasos >= args.max_pasos:
            print(f"\nSe alcanzó el tope de {args.max_pasos} pasos.")
            resumen["detenido_en"] = {"motivo": "max-pasos"}

    (LOG_DIR / f"runner-{sello}.json").write_text(
        json.dumps(resumen, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
    )
    print(f"\nLog: {ruta_log.relative_to(RAIZ)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
#!/usr/bin/env python3
"""Prueba mecánica de todo el andamiaje de agentes de Pharma Express.

No llama a ningún LLM y no modifica el repositorio: comprueba que los archivos,
los skills, el lint y la máquina de estados del orquestador funcionan.

Uso:
    python3 qa/scripts/probar_todo.py
    python3 qa/scripts/probar_todo.py --verbose

Código de salida: 0 si todo pasa, 1 si algo falla.
"""

from __future__ import annotations

import argparse
import importlib.util
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

RAIZ = Path(__file__).resolve().parents[2]
AGENTES = RAIZ / ".claude" / "agents"
SKILLS = RAIZ / ".claude" / "skills"
MVP = RAIZ / "docs" / "mvp.md"
PIPELINE = RAIZ / "pipeline.json"
ORQUESTADOR = RAIZ / "orquestador.py"
LINT = RAIZ / "qa" / "scripts" / "lint_spec.py"
SPEC_MUESTRA = RAIZ / "PHARMA_EXPRESS_SPEC-1.md"

resultados: list[tuple[bool, str, str]] = []


def anotar(ok: bool, nombre: str, detalle: str = "") -> None:
    resultados.append((ok, nombre, detalle))


def leer_frontmatter(path: Path) -> dict[str, str]:
    texto = path.read_text(encoding="utf-8")
    m = re.match(r"^---\r?\n(.*?)\r?\n---", texto, re.S)
    if not m:
        return {}
    datos: dict[str, str] = {}
    for linea in m.group(1).splitlines():
        if ":" in linea:
            clave, valor = linea.split(":", 1)
            datos[clave.strip()] = valor.strip()
    return datos


def compilar_python() -> None:
    archivos = [
        ORQUESTADOR,
        RAIZ / "agentes-ia" / "agente.py",
        LINT,
        RAIZ / "qa" / "scripts" / "marcar.py",
        RAIZ / "qa" / "scripts" / "runner.py",
    ]
    fallos = []
    for path in archivos:
        try:
            compile(path.read_text(encoding="utf-8"), str(path), "exec")
        except SyntaxError as exc:
            fallos.append(f"{path.relative_to(RAIZ)}: {exc}")
    anotar(not fallos, "Sintaxis Python", "; ".join(fallos) or f"{len(archivos)} archivos compilan")


def revisar_agentes() -> None:
    archivos = sorted(AGENTES.glob("*.md"))
    fallos = []
    for path in archivos:
        fm = leer_frontmatter(path)
        if not fm.get("name"):
            fallos.append(f"{path.name}: sin name")
        elif fm["name"] != path.stem:
            fallos.append(f"{path.name}: name={fm['name']}")
        if not fm.get("description"):
            fallos.append(f"{path.name}: sin description")
    anotar(not fallos, "Agentes", "; ".join(fallos) or f"{len(archivos)} agentes con frontmatter")


def revisar_skills() -> None:
    archivos = sorted(SKILLS.glob("*/SKILL.md"))
    fallos = []
    for path in archivos:
        fm = leer_frontmatter(path)
        carpeta = path.parent.name
        if not fm.get("name"):
            fallos.append(f"{carpeta}: sin name")
        elif fm["name"] != carpeta:
            fallos.append(f"{carpeta}: name={fm['name']}")
        if not fm.get("description"):
            fallos.append(f"{carpeta}: sin description")
    anotar(not fallos, "Skills", "; ".join(fallos) or f"{len(archivos)} skills con frontmatter")


def revisar_mvp() -> None:
    texto = MVP.read_text(encoding="utf-8")
    requeridos = [
        "## Requisitos            (dueño: Especificaciones)",
        "## Corte técnico         (dueño: Arquitectura)",
        "## Observaciones",
        "## Registro de decisiones",
    ]
    faltan = [h for h in requeridos if h not in texto]
    anotar(not faltan, "docs/mvp.md", "faltan: " + ", ".join(faltan) if faltan else "secciones y dueños correctos")


def revisar_pipeline() -> None:
    try:
        datos = json.loads(PIPELINE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        anotar(False, "pipeline.json", str(exc))
        return
    faltan = [k for k in ("mvp", "modulos", "iteraciones", "escalados") if k not in datos]
    anotar(not faltan, "pipeline.json", "faltan claves: " + ", ".join(faltan) if faltan else "JSON válido")


def revisar_lint() -> None:
    if not SPEC_MUESTRA.is_file():
        anotar(False, "Lint de SPEC", f"no existe {SPEC_MUESTRA.name}")
        return
    proc = subprocess.run(
        [sys.executable, str(LINT), "--json", str(SPEC_MUESTRA)],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        anotar(False, "Lint de SPEC", proc.stderr.strip() or "el lint falló")
        return
    try:
        datos = json.loads(proc.stdout)
        hallazgos = sum(len(r.get("hallazgos", [])) for r in datos)
    except json.JSONDecodeError as exc:
        anotar(False, "Lint de SPEC", f"salida no es JSON: {exc}")
        return
    anotar(True, "Lint de SPEC", f"{SPEC_MUESTRA.name}: {hallazgos} hallazgos mecánicos")


def cargar_orquestador():
    spec = importlib.util.spec_from_file_location("orquestador", ORQUESTADOR)
    if spec is None or spec.loader is None:
        raise RuntimeError("No se pudo cargar orquestador.py")
    modulo = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(modulo)
    return modulo


def pipeline_base(mvp_aprobado: bool = True, modulo: dict | None = None,
                  iteraciones: dict | None = None,
                  escalados: list | None = None) -> dict:
    datos = {
        "mvp": {"aprobado_por": "persona" if mvp_aprobado else None},
        "modulos": {},
        "iteraciones": iteraciones or {},
        "escalados": escalados or [],
    }
    if modulo is not None:
        datos["modulos"]["identidad"] = modulo
    return datos


def revisar_maquina_de_estados() -> None:
    orquestador = cargar_orquestador()
    casos = [
        ("MVP sin aprobar", pipeline_base(mvp_aprobado=False), "mvp"),
        ("MVP aprobado, sin módulos", pipeline_base(), "registrar-modulos"),
        ("SPEC pendiente", pipeline_base(modulo={"spec": "borrador"}), "spec"),
        ("S1 pendiente", pipeline_base(modulo={"spec": "aprobada"}), "S1"),
        ("S1 NO_APTA", pipeline_base(modulo={"spec": "aprobada", "revision": "NO_APTA"}), "S1"),
        ("S2 pendiente", pipeline_base(modulo={"spec": "aprobada", "revision": "APTA"}), "S2"),
        ("S3 pendiente", pipeline_base(modulo={"spec": "aprobada", "revision": "APTA",
                                               "oraculos": "aprobados"}), "S3"),
        ("B1/B4 pendiente", pipeline_base(modulo={"spec": "aprobada", "revision": "APTA",
                                                   "oraculos": "aprobados",
                                                   "pruebas": "rojas"}), "B1/B4"),
        ("R1 pendiente", pipeline_base(modulo={"spec": "aprobada", "revision": "APTA",
                                                "oraculos": "aprobados", "pruebas": "rojas",
                                                "implementacion": "verde"}), "R1"),
        ("Entrega", pipeline_base(modulo={"spec": "aprobada", "revision": "APTA",
                                           "oraculos": "aprobados", "pruebas": "verdes",
                                           "implementacion": "verde", "humo": "verde"}), "entrega"),
        ("3 iteraciones", pipeline_base(modulo={"spec": "aprobada"}, iteraciones={"identidad": 3}), "escalar"),
        ("Escalado global", pipeline_base(escalados=[{"modulo": "identidad", "motivo": "prueba"}]), "escalado"),
    ]
    fallos = []
    for nombre, datos, esperado in casos:
        obtenido = orquestador.siguiente(datos)[0]["paso"]
        if obtenido != esperado:
            fallos.append(f"{nombre}: esperaba {esperado}, obtuve {obtenido}")
    anotar(not fallos, "Máquina de estados", "; ".join(fallos) or f"{len(casos)} transiciones correctas")


def revisar_check_cli() -> None:
    orquestador = cargar_orquestador()
    casos = [
        ("bloqueado por MVP", pipeline_base(mvp_aprobado=False), 1),
        ("todo en verde", pipeline_base(modulo={"spec": "aprobada", "revision": "APTA",
                                                 "oraculos": "aprobados", "pruebas": "verdes",
                                                 "implementacion": "verde", "humo": "verde"}), 0),
    ]
    fallos = []
    with tempfile.TemporaryDirectory() as tmp:
        for nombre, datos, esperado in casos:
            archivo = Path(tmp) / "pipeline.json"
            archivo.write_text(json.dumps(datos), encoding="utf-8")
            proc = subprocess.run(
                [sys.executable, str(ORQUESTADOR), "--archivo", str(archivo), "--check"],
                capture_output=True,
                text=True,
            )
            if proc.returncode != esperado:
                fallos.append(f"{nombre}: esperaba {esperado}, obtuve {proc.returncode}")
    anotar(not fallos, "orquestador --check", "; ".join(fallos) or "códigos de salida correctos")


def revisar_runner() -> None:
    proc = subprocess.run(
        [sys.executable, str(RAIZ / "qa" / "scripts" / "runner.py"), "--estado"],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        anotar(False, "Runner", proc.stderr.strip() or f"código {proc.returncode}")
        return
    if "Siguiente paso" not in proc.stdout:
        anotar(False, "Runner", "no muestra el siguiente paso")
        return
    anotar(True, "Runner", "detecta backend y muestra el siguiente paso")


def main() -> int:
    parser = argparse.ArgumentParser(description="Prueba mecánica del andamiaje.")
    parser.add_argument("--verbose", action="store_true", help="Muestra el detalle de cada prueba.")
    args = parser.parse_args()

    compilar_python()
    revisar_agentes()
    revisar_skills()
    revisar_mvp()
    revisar_pipeline()
    revisar_lint()
    revisar_maquina_de_estados()
    revisar_check_cli()
    revisar_runner()

    print("Pharma Express — prueba mecánica del andamiaje\n")
    for ok, nombre, detalle in resultados:
        marca = "OK  " if ok else "FALLA"
        print(f"  [{marca}] {nombre}" + (f" — {detalle}" if detalle and (args.verbose or not ok) else ""))

    fallos = sum(1 for ok, _, _ in resultados if not ok)
    print(f"\n{len(resultados) - fallos}/{len(resultados)} pruebas pasaron.")
    if fallos:
        print("Revisa los detalles con --verbose.")
        return 1
    print("Andamiaje consistente. Los agentes concretos se prueban aparte (ver docs/COMO-PROBAR.md).")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
#!/usr/bin/env python3
"""Marca el estado del pipeline sin editar pipeline.json a mano.

No ejecuta agentes: solo actualiza el estado y valida los valores permitidos.
Después de marcar, corre `python3 orquestador.py` para ver el siguiente paso.

Uso:
    python3 qa/scripts/marcar.py mostrar
    python3 qa/scripts/marcar.py mvp --estado aprobado --aprobado-por "Nombre"
    python3 qa/scripts/marcar.py modulo identidad --spec aprobada
    python3 qa/scripts/marcar.py modulo identidad --revision APTA
    python3 qa/scripts/marcar.py modulo identidad --oraculos aprobados
    python3 qa/scripts/marcar.py modulo identidad --pruebas rojas
    python3 qa/scripts/marcar.py modulo identidad --implementacion verde
    python3 qa/scripts/marcar.py modulo identidad --humo verde
    python3 qa/scripts/marcar.py iteracion identidad
    python3 qa/scripts/marcar.py escalar identidad "3 intentos sin progreso"
"""

from __future__ import annotations

import argparse
import json
import sys
from datetime import date
from pathlib import Path

RAIZ = Path(__file__).resolve().parents[2]
PIPELINE = RAIZ / "pipeline.json"

VALORES = {
    "mvp_estado": {"borrador", "en_negociacion", "aprobado"},
    "spec": {"pendiente", "borrador", "candidata", "aprobada"},
    "revision": {"pendiente", "APTA", "APTA_CON_RESERVAS", "NO_APTA"},
    "oraculos": {"pendiente", "aprobados"},
    "pruebas": {"pendiente", "rojas", "verdes"},
    "implementacion": {"pendiente", "en_curso", "verde"},
    "humo": {"pendiente", "en_curso", "verde", "fallido"},
}


def cargar(path: Path) -> dict:
    if not path.is_file():
        sys.exit(f"No existe {path}")
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        sys.exit(f"{path} no es JSON válido: {exc}")


def guardar(path: Path, datos: dict) -> None:
    datos["actualizado"] = date.today().isoformat()
    temporal = path.with_suffix(".tmp")
    temporal.write_text(json.dumps(datos, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    temporal.replace(path)


def validar(campo: str, valor: str) -> str:
    permitidos = VALORES[campo]
    if valor not in permitidos:
        sys.exit(f"Valor inválido para {campo}: «{valor}». Permitidos: {', '.join(sorted(permitidos))}")
    return valor


def modulo(datos: dict, nombre: str) -> dict:
    return datos.setdefault("modulos", {}).setdefault(
        nombre,
        {
            "spec": "pendiente",
            "revision": "pendiente",
            "oraculos": "pendiente",
            "pruebas": "pendiente",
            "implementacion": "pendiente",
            "humo": "pendiente",
        },
    )


def main() -> int:
    parser = argparse.ArgumentParser(description="Marca el estado del pipeline.")
    parser.add_argument("--archivo", default=str(PIPELINE), help="Ruta alternativa de pipeline.json.")
    sub = parser.add_subparsers(dest="comando", required=True)

    p_mostrar = sub.add_parser("mostrar", help="Imprime el pipeline actual.")
    p_mostrar.set_defaults(func=lambda d, a: None)

    p_mvp = sub.add_parser("mvp", help="Actualiza el estado del MVP.")
    p_mvp.add_argument("--estado", choices=sorted(VALORES["mvp_estado"]))
    p_mvp.add_argument("--aprobado-por", dest="aprobado_por")
    p_mvp.add_argument("--ronda", type=int)

    p_mod = sub.add_parser("modulo", help="Actualiza el estado de un módulo.")
    p_mod.add_argument("nombre")
    for campo in ("spec", "revision", "oraculos", "pruebas", "implementacion", "humo"):
        p_mod.add_argument(f"--{campo}", choices=sorted(VALORES[campo]))

    p_it = sub.add_parser("iteracion", help="Suma una iteración de corrección a un módulo.")
    p_it.add_argument("nombre")

    p_esc = sub.add_parser("escalar", help="Registra un escalamiento.")
    p_esc.add_argument("nombre")
    p_esc.add_argument("motivo")

    p_res = sub.add_parser("resolver-escalado", help="Quita el escalamiento de un módulo.")
    p_res.add_argument("nombre")

    args = parser.parse_args()
    path = Path(args.archivo)
    datos = cargar(path)

    if args.comando == "mostrar":
        print(json.dumps(datos, ensure_ascii=False, indent=2))
        return 0

    if args.comando == "mvp":
        mvp = datos.setdefault("mvp", {})
        if args.estado:
            mvp["estado"] = validar("mvp_estado", args.estado)
        if args.ronda is not None:
            mvp["ronda"] = args.ronda
        if args.aprobado_por is not None:
            if not args.aprobado_por.strip():
                sys.exit("--aprobado-por no puede estar vacío")
            mvp["aprobado_por"] = args.aprobado_por.strip()
        if mvp.get("estado") == "aprobado" and not mvp.get("aprobado_por"):
            sys.exit("Un MVP aprobado necesita --aprobado-por con el nombre de la persona.")

    elif args.comando == "modulo":
        campos = {
            "spec": args.spec,
            "revision": args.revision,
            "oraculos": args.oraculos,
            "pruebas": args.pruebas,
            "implementacion": args.implementacion,
            "humo": args.humo,
        }
        campos = {k: validar(k, v) for k, v in campos.items() if v is not None}
        if not campos:
            sys.exit("Indica al menos un campo: --spec, --revision, --oraculos, --pruebas, --implementacion o --humo.")
        modulo(datos, args.nombre).update(campos)

    elif args.comando == "iteracion":
        iteraciones = datos.setdefault("iteraciones", {})
        iteraciones[args.nombre] = iteraciones.get(args.nombre, 0) + 1
        print(f"{args.nombre}: iteración {iteraciones[args.nombre]}")

    elif args.comando == "escalar":
        datos.setdefault("escalados", []).append(
            {"modulo": args.nombre, "motivo": args.motivo, "fecha": date.today().isoformat()}
        )

    elif args.comando == "resolver-escalado":
        antes = len(datos.get("escalados", []))
        datos["escalados"] = [
            e for e in datos.get("escalados", []) if e.get("modulo") != args.nombre
        ]
        print(f"Escalamientos de {args.nombre}: {antes - len(datos['escalados'])} resueltos")

    guardar(path, datos)
    print(f"Actualizado {path}")
    print("Siguiente paso: python3 orquestador.py" + ("" if path == PIPELINE else f" --archivo {path}"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
