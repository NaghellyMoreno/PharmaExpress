# Modelos de IA por subagente (no escribir modelos dentro de los prompts).
# Copia este archivo a .env y completa los nombres exactos del proveedor que uses.
# .env está en .gitignore: nunca lo subas.

PROVEEDOR_POR_DEFECTO=gemini

# Categoría fuerte: juicio y negociación; el error se propaga.
MODELO_ESPECIFICACIONES=
MODELO_ARQUITECTURA=
MODELO_S1=
MODELO_S2=
MODELO_B1=

# Categoría intermedia: siguen plantillas y un resultado verificable.
MODELO_S3=
MODELO_B2=
MODELO_B3=
MODELO_B4=
MODELO_R2=

# Categoría barata / intermedia: siguen un guion.
MODELO_R1=

# Presupuesto global de llamadas (además del tope de 3 iteraciones y 8 pasos de R2).
PRESUPUESTO_DIARIO_LLAMADAS=200
# Oráculos pendientes de aprobación humana

