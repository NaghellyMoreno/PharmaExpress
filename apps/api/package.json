{
  "name": "@pharma-express/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de Pharma Express: NestJS modular, PostgreSQL + Prisma, pg-boss, grammY.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:unidad": "jest --selectProjects unidad",
    "test:integracion": "jest --selectProjects integracion",
    "test:modulo": "jest --",
    "guardian": "python3 ../../qa/scripts/guardian.py revisar",
    "start:dev": "ts-node src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.22",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "grammy": "^1.33.0",
    "multer": "^2.5.0",
    "pg-boss": "^10.1.5",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "prisma": "^6.1.0",
    "testcontainers": "^10.16.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
